rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in ["Givemeai.edit@gmail.com", "givemeai.edit@gmail.com"];
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validOwnCreate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "photoURL",
          "lastLoginAt",
          "status",
          "createdAt"
        ]);
    }

    function validOwnUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["displayName", "photoURL", "lastLoginAt"])
        && request.resource.data.status == resource.data.status;
    }

    function validVipRedeem(uid) {
      let code = request.resource.data.vipCode;
      return isOwner(uid)
        && code is string
        && exists(/databases/$(database)/documents/vipCodes/$(code))
        && get(/databases/$(database)/documents/vipCodes/$(code)).data.status == "active"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "vipCode",
          "approvedAt",
          "approvedBy"
        ])
        && request.resource.data.status == "approved"
        && request.resource.data.vipCode == code
        && request.resource.data.approvedAt == request.time
        && request.resource.data.approvedBy == "VIP_CODE";
    }

    match /users/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || validOwnCreate(uid);
      allow update: if isAdmin() || (isOwner(uid) && (validOwnUpdate() || validVipRedeem(uid)));
      allow delete: if false;

      match /favorites/{gptId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(["gptId", "createdAt"])
          && request.resource.data.gptId == gptId
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /vipCodes/{code} {
      allow get: if isAdmin() || (signedIn() && resource.data.status == "active");
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "code",
          "status",
          "createdAt",
          "createdBy"
        ])
        && request.resource.data.code == code
        && code.matches("^[A-Z0-9]{5}$")
        && request.resource.data.status == "active"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isAdmin()
        || (signedIn()
        && resource.data.status == "active"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "email",
          "usedAt",
          "usedBy",
          "usedByUid"
        ])
        && request.resource.data.status == "used"
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.usedAt == request.time
        && request.resource.data.usedBy == request.auth.token.email
        && request.resource.data.usedByUid == request.auth.uid);
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && announcementId == "current"
        && request.resource.data.keys().hasOnly([
          "enabled",
          "message",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.message is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /gptSettings/{gptId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "order",
          "visible",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.order is number
        && request.resource.data.visible is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /sitePages/{pageId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && pageId == "pricing"
        && request.resource.data.keys().hasOnly([
          "price",
          "headline",
          "description",
          "benefits",
          "ctaText",
          "facebookUrl",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.price is string
        && request.resource.data.headline is string
        && request.resource.data.description is string
        && request.resource.data.benefits is list
        && request.resource.data.ctaText is string
        && request.resource.data.facebookUrl is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /analyticsEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          "type",
          "gptId",
          "path",
          "createdAt"
        ])
        && request.resource.data.type in [
          "gpt_open",
          "copy_link",
          "locked_click",
          "detail_view",
          "signup_cta"
        ]
        && request.resource.data.gptId is string
        && request.resource.data.path is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
