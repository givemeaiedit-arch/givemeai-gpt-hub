rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /learningHistory/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /toolUsage/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /lessonScores/{scoreId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && scoreId == request.auth.uid + "_" + request.resource.data.lessonId
        && request.resource.data.lessonId in ["lesson-1", "lesson-2", "lesson-3"]
        && request.resource.data.points == 50;
      allow update, delete: if false;
    }
  }
}
