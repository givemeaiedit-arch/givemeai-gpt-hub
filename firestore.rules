rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ["Givemeai.edit@gmail.com", "givemeai.edit@gmail.com"];
    }

    function userWritableFields() {
      return [
        "email",
        "googleDisplayName",
        "googlePhotoURL",
        "displayName",
        "photoURL",
        "updatedAt"
      ];
    }

    function userCreateFields() {
      return [
        "email",
        "googleDisplayName",
        "googlePhotoURL",
        "displayName",
        "photoURL",
        "updatedAt",
        "createdAt"
      ];
    }

    function adminWritableUserFields() {
      return [
        "plan",
        "tier",
        "memberLevel",
        "subscriptionStatus",
        "adCheckCredits",
        "proLifetime",
        "proExpiresAt",
        "dailyAdCheckLimit",
        "proActivatedAt",
        "proSource",
        "proTopupOrderId",
        "updatedAt"
      ];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userCreateFields())
        && request.resource.data.createdAt == request.time;
      allow update: if (
          isOwner(userId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(userWritableFields())
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(adminWritableUserFields())
        );
      allow delete: if false;

      match /learningHistory/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /toolUsage/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /adCheckHistory/{checkId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /lessonScores/{scoreId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && scoreId == request.auth.uid + "_" + request.resource.data.lessonId
        && request.resource.data.lessonId in ["lesson-1", "lesson-2", "lesson-3"]
        && request.resource.data.points == 50;
      allow update, delete: if false;
    }

    match /adCheckHistory/{checkId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pageViews/{viewId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          "path",
          "page",
          "visitorId",
          "uid",
          "email",
          "title",
          "createdAt"
        ])
        && request.resource.data.path is string
        && request.resource.data.page is string
        && request.resource.data.visitorId is string
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && request.resource.data.title is string
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.uid == ""
          || (isSignedIn() && request.resource.data.uid == request.auth.uid)
        )
        && (
          request.resource.data.email == ""
          || (isSignedIn() && request.resource.data.email == request.auth.token.email)
        );
      allow update, delete: if false;
    }

    match /topupOrders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /communityRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /promptLibrary/{promptId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
